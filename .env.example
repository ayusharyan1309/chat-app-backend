# =====================================================================================
# Chat Platform environment. Copy to .env and adjust.
# Defaults run everything embedded (H2 + in-memory cache/bus + local media): no services needed.
# Connector values here are only the *bootstrap* defaults — the dashboard can switch any of
# them live (Infrastructure page), and those choices are persisted in the control plane.
# =====================================================================================

# ---- Security (required in production) -----------------------------------------------
# 32+ random characters each, identical on every node. Generate: openssl rand -base64 48
PLATFORM_MASTER_KEY=
PLATFORM_JWT_SECRET=
# First dashboard login (created only when no admin exists yet). Change after first login.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin12345
# Allow tenant webhooks/JWKS URLs that resolve to private networks (dev only).
PLATFORM_SECURITY_ALLOW_PRIVATE_NETWORK_CALLBACKS=false

# ---- Node ------------------------------------------------------------------------------
PORT=8080
PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# NODE_ID=node-1                # auto-generated when empty

# ---- Control plane database (tenants, plans, keys, configs, audit) ----------------------
CONTROL_DB_URL=jdbc:h2:file:./data/control-plane
CONTROL_DB_USERNAME=sa
CONTROL_DB_PASSWORD=
# PostgreSQL:  CONTROL_DB_URL=jdbc:postgresql://postgres:5432/chat_control  CONTROL_DB_USERNAME=chat  CONTROL_DB_PASSWORD=chat
# MySQL:       CONTROL_DB_URL=jdbc:mysql://mysql:3306/chat                   CONTROL_DB_USERNAME=chat  CONTROL_DB_PASSWORD=chat

# ---- Message store (users, conversations, messages) -------------------------------------
# h2 | postgresql | mysql | supabase | mongodb | cassandra | firestore | memory
MESSAGE_STORE_PROVIDER=h2
MESSAGE_STORE_URL=jdbc:h2:file:./data/chat-store
MESSAGE_STORE_USERNAME=sa
MESSAGE_STORE_PASSWORD=
# PostgreSQL:  MESSAGE_STORE_PROVIDER=postgresql  MESSAGE_STORE_URL=jdbc:postgresql://postgres:5432/chat_messages  MESSAGE_STORE_USERNAME=chat  MESSAGE_STORE_PASSWORD=chat
# Supabase:    MESSAGE_STORE_PROVIDER=supabase    MESSAGE_STORE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# MongoDB, Cassandra and Firestore take provider-specific settings: configure them from the dashboard.

# ---- Cache: memory | redis ---------------------------------------------------------------
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379

# ---- Event bus: memory | redis | kafka (use redis or kafka when running >1 node) ---------
EVENT_BUS_PROVIDER=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Prefix for the platform's internal topics/channels, so several deployments can share one broker.
BUS_TOPIC_PREFIX=

# ---- Media storage: local | s3 ------------------------------------------------------------
BLOB_STORE_PROVIDER=local
MEDIA_DIRECTORY=./data/media
# S3 / MinIO / R2: BLOB_STORE_PROVIDER=s3  S3_BUCKET=chat-media  S3_REGION=us-east-1  S3_ENDPOINT=http://minio:9000
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# ---- Push: none | fcm | webhook (configure credentials from the dashboard) ---------------
PUSH_PROVIDER=none

# =====================================================================================
# Preset: production-like single host (docker compose --profile postgres --profile redis up)
#   CONTROL_DB_URL=jdbc:postgresql://postgres:5432/chat_control
#   CONTROL_DB_USERNAME=chat
#   CONTROL_DB_PASSWORD=chat
#   MESSAGE_STORE_PROVIDER=postgresql
#   MESSAGE_STORE_URL=jdbc:postgresql://postgres:5432/chat_messages
#   MESSAGE_STORE_USERNAME=chat
#   MESSAGE_STORE_PASSWORD=chat
#   CACHE_PROVIDER=redis
#   EVENT_BUS_PROVIDER=redis
#   REDIS_URL=redis://redis:6379
#
# Preset: cluster (add --profile cluster; nodes MUST share DB, cache and bus — use the values above)
# =====================================================================================
