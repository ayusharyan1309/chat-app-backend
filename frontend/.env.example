# Copy to .env.local (git-ignored) and adjust. Every variable is optional.

# Base URL the browser uses for REST calls. Leave empty to stay same-origin, which is the
# recommended setup: the Vite dev server proxies /api, /ws and /ws-sockjs to the backend.
# Set it only when the console is served from a different origin than the backend
# (the backend must then allow that origin via CORS).
VITE_API_BASE=

# Realtime STOMP endpoint (native WebSocket). Defaults to ws(s)://<VITE_API_BASE or page host>/ws.
VITE_WS_URL=

# Dev/preview server only (not exposed to the browser): where the proxy forwards /api and /ws.
DEV_PROXY_TARGET=http://localhost:8080
